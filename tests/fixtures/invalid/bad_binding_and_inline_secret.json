{
  "$schema": "../../../contracts/schema/tool-contract.v1.json",
  "_comment": "REJECTION FIXTURE: unknown binding type, a hardcoded token where a secretRef belongs, a name that is not snake_case, and a description too short to route on.",
  "contractVersion": "1.0.0",
  "kind": "single-tool",
  "interface": {
    "name": "SendSMS",
    "title": "Send SMS",
    "description": "Sends a text.",
    "whenToUse": ["The user wants a text message sent."],
    "input": {
      "schema": {
        "type": "object",
        "properties": { "to": { "type": "string" }, "body": { "type": "string" } },
        "required": ["to", "body"],
        "additionalProperties": false
      }
    },
    "response": {
      "schema": {
        "type": "object",
        "properties": { "messageId": { "type": "string" } },
        "required": ["messageId"]
      }
    }
  },
  "binding": {
    "type": "grpc",
    "http": {
      "baseUrl": "https://sms.partner.example",
      "method": "POST",
      "path": "/v1/messages",
      "auth": { "type": "bearer", "secretRef": "sk-live-9f3a2b7c1d4e5f60" },
      "timeoutMs": 5000
    }
  },
  "governance": {
    "annotations": { "readOnly": false, "destructive": false, "idempotent": false, "openWorld": true },
    "execution": { "mode": "direct", "humanApproval": "never" },
    "caching": { "cacheable": false }
  }
}
