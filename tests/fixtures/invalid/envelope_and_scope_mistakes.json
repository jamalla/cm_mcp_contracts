{
  "$schema": "../../../schema/tool-contract.v1.json",
  "_comment": "REJECTION FIXTURE: no declared scopes, a paginated response that claims not to be a collection, a misspelled Salla scope pattern, and a description too short to route on.",
  "contractVersion": "1.0.0",
  "kind": "single-tool",
  "interface": {
    "name": "CouponCodes",
    "title": "List Coupon Codes",
    "description": "Lists codes.",
    "whenToUse": [
      "The merchant asks for coupon codes."
    ],
    "input": {
      "schema": {
        "type": "object",
        "properties": {
          "couponId": {
            "type": "integer"
          }
        }
      }
    },
    "response": {
      "schema": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string"
          }
        }
      }
    },
    "annotations": {
      "readOnlyHint": true,
      "destructiveHint": false,
      "idempotentHint": true,
      "openWorldHint": true
    }
  },
  "binding": {
    "type": "http",
    "http": {
      "method": "GET",
      "path": "/coupons/codes",
      "auth": {
        "scopes": [
          "coupons.write"
        ]
      },
      "response": {
        "dataPath": "data",
        "collection": false,
        "pagination": "standard"
      }
    }
  },
  "governance": {
    "execution": {
      "mode": "direct",
      "humanApproval": "never"
    },
    "caching": {
      "cacheable": true,
      "ttlSeconds": 300
    }
  }
}
